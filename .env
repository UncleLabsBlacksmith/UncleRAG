# คัดลอกไฟล์นี้เป็น .env แล้วใส่คีย์จริง
# อย่า commit .env เข้า git

OPENROUTER_API_KEY=sk-or-v1-29f64acb6d81xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxdebb35990cff204f3a8293

# slug ดูได้ที่ https://openrouter.ai/models
CHAT_MODEL=anthropic/claude-sonnet-5

# openrouter = ยิง API   |   local = ใช้ sentence-transformers บนเครื่อง
EMBED_BACKEND=openrouter
EMBED_MODEL=openai/text-embedding-3-large

RAG_DB=rag.db

# ปรับคุณภาพ retrieval
CHUNK_SIZE=900          # จำนวนตัวอักษรต่อ chunk
CHUNK_OVERLAP=180
TOP_K=6                 # ส่งกี่ chunk เข้า prompt
MIN_SCORE=0.25          # cosine ต่ำกว่านี้ตัดทิ้ง
MAX_TOKENS=2048
